<resources>
    <!-- Default TextView style -->
    <style name="AppTextStyleBold">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/poppinsbold</item>
    </style>

    <style name="AppTextStyleMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/poppinsmedium</item>
    </style>

    <style name="AppTextStyleRegular">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/aqua</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/poppinsregular</item>
    </style>

    <!-- Default ImageView style -->
    <style name="AppImageStyle">
        <item name="android:scaleType">centerCrop</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- Default Button style -->
    <style name="AppButtonLarge">
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">32dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="AppButtonRegular">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">24dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="AppButtonSmall">
        <item name="backgroundTint">@color/aqua</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

</resources>